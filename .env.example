# Copy to .env and adjust. Scripts read PRIVATE_AI_AUTH_TOKEN; the gateway reads all of these.

# Bearer token the gateway requires on every request. CHANGE THIS for any non-local use.
PRIVATE_AI_AUTH_TOKEN=private-portfolio-token

# Optional: override the audit/log directory (defaults to <project_root>/logs).
# PRIVATE_AI_LOG_DIR=

# Optional: path to the governance policy file (defaults to <project_root>/config/policy.toml).
# If absent, the gateway runs single-principal using PRIVATE_AI_AUTH_TOKEN. See config/policy.example.toml.
# PRIVATE_AI_POLICY_PATH=

# Optional: max request body size in bytes (default 8 MiB). Bounds input-size DoS.
# PRIVATE_AI_MAX_CONTENT_LENGTH=8388608

# Optional: output token caps (defaults shown).
# PRIVATE_AI_MAX_OUTPUT_TOKENS=4096
# PRIVATE_AI_MAX_OUTPUT_TOKENS_STRATEGY=4096
# PRIVATE_AI_MAX_OUTPUT_TOKENS_ENGINEERING=4096
# PRIVATE_AI_MAX_OUTPUT_TOKENS_OFFSEC=4096

# Optional: inference backend selection — "auto" (default) | "mlx" | "openai" | "demo".
# auto prefers a configured upstream, then MLX where importable, then the demo simulator.
# PRIVATE_AI_BACKEND=auto

# Optional: OpenAI-compatible upstream for the "openai" backend (LLMaaS, vLLM, TGI,
# Ollama, LM Studio, ...), e.g. http://127.0.0.1:11434/v1
# PRIVATE_AI_UPSTREAM_BASE_URL=
# PRIVATE_AI_UPSTREAM_API_KEY=

# --- durable state (Step 7A) ---------------------------------------------------------
# Optional: state backend — "memory" (default; restart-forgetting) | "sqlite" (durable).
# "sqlite" persists the authority store (runs/approvals) and the evidence database as two
# separate, exclusively-owned, integrity-checked SQLite files under PRIVATE_AI_STATE_DIR.
# The directory must already exist and be writable. Requires the repo's agents/ packages
# to be importable (run from the repo checkout, or set PRIVATE_AI_AGENTS_PATH).
# PRIVATE_AI_STATE_BACKEND=memory
# PRIVATE_AI_STATE_DIR=

# --- live durable evidence (Step 7B.0) -----------------------------------------------
# Optional: evidence mode — "off" (default) | "durable". "durable" requires
# PRIVATE_AI_STATE_BACKEND=sqlite and BOTH emitter keys below; it opens the durable
# evidence store as a live sink (assurance-owned construction, ownership held for the
# process lifetime), forces REQUIRE_AUTHORIZATION_EVIDENCE on (fail-closed emits), and
# routes the gateway's approval_decided/execute_validated and OpenCode's apply_result
# into one durable signed chain that OpenClaw verifies fail-closed. This is the
# recommended hardened configuration. Misconfiguration (missing/short/non-hex keys,
# memory backend) fails closed at startup.
# PRIVATE_AI_EVIDENCE_MODE=off

# Per-emitter HMAC signing keys (hex-encoded, >= 16 bytes / 32 hex chars; 32 bytes
# recommended: `openssl rand -hex 32`). Each emitter reads ONLY its own variable; the
# assurance plane (openclaw) assembles the verification registry from all three. Symmetric
# HMAC is tamper-evident, not non-repudiable. Never commit real values.
#
# Since Step 7C.1 OpenClaw signs its OWN verdict, so it holds a third key. Only OpenClaw
# receives it: the gateway must not be able to author a verifier conclusion, and neither
# must the executor whose work is being judged.
# PRIVATE_AI_EVIDENCE_KEY_GATEWAY=
# PRIVATE_AI_EVIDENCE_KEY_OPENCODE=
# PRIVATE_AI_EVIDENCE_KEY_OPENCLAW=
